<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fsln.files</ToolCommandName>
    <RootNamespace>FSLN.Files</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="State\Pane.fs" />
    <Compile Include="State\State.fs" />
    <Compile Include="State\ShellExtensions.fs" />
    <Compile Include="State\PaneCommands.fs" />
    <Compile Include="State\StateCommands.fs" />
    <Compile Include="View.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\FSLN.Shared\FSLN.Shared.fsproj" />
  </ItemGroup>
</Project>