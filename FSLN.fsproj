<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fsln</ToolCommandName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Path.fs" />
    <Compile Include="GitStatus.fs" />
    <Compile Include="Input\InputThread.fs" />
    <Compile Include="Input\CommandBuffer.fs" />
    <Compile Include="Tree\FileTree.fs" />
    <Compile Include="Tree\FileTreeFileOperations.fs" />
    <Compile Include="Tree\FileTreeReorderOperations.fs" />
    <Compile Include="Tree\Solution.fs" />
    <Compile Include="Tree\SolutionLoader.fs" />
    <Compile Include="State\Theme.fs" />
    <Compile Include="State\Selection.fs" />
    <Compile Include="State\InteractiveState.fs" />
    <Compile Include="Interactive\InteractiveDisplay.fs" />
    <Compile Include="Interactive\Commands.fs" />
    <Compile Include="Interactive\Interactive.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="matkoch.Microsoft.VisualStudio.SolutionPersistence" Version="1.0.61" />
    <PackageReference Include="Microsoft.Build" Version="18.6.3" />
  </ItemGroup>
</Project>