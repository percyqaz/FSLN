<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>fsln</ToolCommandName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Path.fs" />
    <Compile Include="GitStatus.fs" />
    <Compile Include="Workspace\OrderFile.fs" />
    <Compile Include="Workspace\Workspace.fs" />
    <Compile Include="Workspace\FileSystemProject.fs" />
    <Compile Include="Workspace\FSharpProject.fs" />
    <Compile Include="Workspace\ProjectGuts.fs" />
    <Compile Include="Tree\FileTree.fs" />
    <Compile Include="Tree\Solution.fs" />
    <Compile Include="Tree\FileTreeFileOperations.fs" />
    <Compile Include="Tree\FileTreeReorderOperations.fs" />
    <Compile Include="Tree\WorkspaceLoader.fs" />
    <Compile Include="FilteredTree\FilteredTree.fs" />
    <Compile Include="FilteredTree\Filter.fs" />
    <Compile Include="Input\InputThread.fs" />
    <Compile Include="Input\CommandBuffer.fs" />
    <Compile Include="Input\TextBuffer.fs" />
    <Compile Include="State\Config\Theme.fs" />
    <Compile Include="State\Config\Editors.fs" />
    <Compile Include="State\Modes\Selection.fs" />
    <Compile Include="State\Modes\FSelection.fs" />
    <Compile Include="State\Modes\NormalMode.fs" />
    <Compile Include="State\Modes\SearchMode.fs" />
    <Compile Include="State\Modes\GitMode.fs" />
    <Compile Include="State\Modes\Mode.fs" />
    <Compile Include="State\State.fs" />
    <Compile Include="State\NormalModeCommands.fs" />
    <Compile Include="State\SearchModeCommands.fs" />
    <Compile Include="State\StateCommands.fs" />
    <Compile Include="UI\AnsiCodes.fs" />
    <Compile Include="UI\ScreenBuffer.fs" />
    <Compile Include="UI\Display.fs" />
    <Compile Include="CommandDispatcher.fs" />
    <Compile Include="FSLN.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="matkoch.Microsoft.VisualStudio.SolutionPersistence" Version="1.0.61" />
    <PackageReference Include="Microsoft.Build" Version="18.6.3" />
  </ItemGroup>
</Project>